# ---------- Core ----------
# URL users open in the browser for local dev (pnpm dev).
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
PORT=4000
# Public URL of the full Docker stack (docker compose up). Used only by docker-compose.yml.
DOCKER_PUBLIC_URL=http://localhost:8080

# ---------- Data ----------
DATABASE_URL=postgresql://ebook:ebook@localhost:5432/ebook_studio
REDIS_URL=redis://localhost:6379
# Native API and worker must share this namespace; use distinct values per deployment.
QUEUE_NAMESPACE=development
# Docker overrides the native namespace to prevent cross-consumption.
DOCKER_QUEUE_NAMESPACE=docker-local
# Optional local file storage root; API and worker must share actual files.
# STORAGE_DIR=/absolute/shared/storage

# ---------- Google login (optional) ----------
# Redirect URI: <PUBLIC_URL>/api/v1/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Email (Mailpit in dev: http://localhost:8025) ----------
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 (STARTTLS) or 465 (TLS).
# Use your full Gmail address for SMTP_USER and a Google App Password for SMTP_PASS.
# Set SMTP_FROM="eBookStudio <your-gmail-address>" to match the authenticated sender.
# Docker Mailpit: SMTP_HOST=mailpit; native development Mailpit: SMTP_HOST=localhost.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="eBookStudio <no-reply@ebookstudio.local>"

# ---------- OpenAI ----------
OPENAI_API_KEY=
# Model names are configuration, not code. Benchmark cost/quality before fixing defaults.
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_QUALITY_MODEL=gpt-5
OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst
# Product credits per saved image (server-enforced; not provider currency pricing).
IMAGE_GENERATION_CREDITS=20
# Only sent to reasoning models (gpt-5*, o*). Empty = model default.
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT_MS=120000
# Set to 1 to use a deterministic fake AI (tests / no API key)
AI_MOCK=0

# ---------- Object storage ----------
# Leave S3_ENDPOINT empty to store files on the local filesystem (backend/storage).
# For production use AWS S3, Cloudflare R2 or another S3-compatible service.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=ebook-studio
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false

# ---------- Payments ----------
# Which payment processor this build talks to: `stripe` or `local`.
# `local` simulates a checkout without contacting a provider, and is what the
# local billing journey and the development environment use.
PAYMENT_PROVIDER=local
# The secret the payment provider signs its webhooks with. Required: the API
# refuses to start without it, because a webhook without a valid signature must
# be refused rather than trusted. Use a different value from STRIPE_WEBHOOK_SECRET.
# Generate with: openssl rand -base64 32
PAYMENT_WEBHOOK_SECRET=replace-with-a-random-secret-at-least-16-chars
# The local test processor grants credits without taking payment. A production
# build (NODE_ENV=production, as in docker-compose) refuses to start with it
# unless this is true. Set it only on a private test stack, never on a public one.
ALLOW_LOCAL_PAYMENTS=false
# How old a webhook signature may be, in seconds.
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
# Stripe's secret API key. Test mode keys start with `sk_test_`.
# Only needed when PAYMENT_PROVIDER=stripe.
STRIPE_SECRET_KEY=
# Stripe's publishable key, used by the browser to open the checkout page.
STRIPE_PUBLISHABLE_KEY=
# Stripe's webhook endpoint signing secret (`whsec_...`).
STRIPE_WEBHOOK_SECRET=

# ---------- Operations ----------
# Where operational alerts are delivered. Empty means alerts are refused rather
# than silently dropped.
ALERT_DESTINATION=
# Where database and asset backups are written (admin console > Backups).
BACKUP_DIR=
# The PostgreSQL container used for pg_dump when the client tools are not on the host.
PG_CONTAINER=

# ---------- Frontend ----------
# Where the Next.js server proxies /api/* to.
BACKEND_INTERNAL_URL=http://localhost:4000
# The public address of the site. Used for canonical links, Open Graph URLs
# and the sitemap. Leave unset for a local build.
# NEXT_PUBLIC_SITE_URL=https://ebookstudio.example.com
