# ---------- Core ----------
# URL users open in the browser for local dev (pnpm dev).
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
PORT=4000
# Public URL of the full Docker stack (docker compose up). Used only by docker-compose.yml.
DOCKER_PUBLIC_URL=http://localhost:8080

# ---------- Data ----------
DATABASE_URL=postgresql://ebook:ebook@localhost:5432/ebook_studio
REDIS_URL=redis://localhost:6379
# Native API and worker must share this namespace; use distinct values per deployment.
QUEUE_NAMESPACE=development
# Docker overrides the native namespace to prevent cross-consumption.
DOCKER_QUEUE_NAMESPACE=docker-local
# Optional local file storage root; API and worker must share actual files.
# STORAGE_DIR=/absolute/shared/storage

# ---------- Google login (optional) ----------
# Redirect URI: <PUBLIC_URL>/api/v1/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Email (Mailpit in dev: http://localhost:8025) ----------
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 (STARTTLS) or 465 (TLS).
# Use your full Gmail address for SMTP_USER and a Google App Password for SMTP_PASS.
# Set SMTP_FROM="eBookStudio <your-gmail-address>" to match the authenticated sender.
# Docker Mailpit: SMTP_HOST=mailpit; native development Mailpit: SMTP_HOST=localhost.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="eBookStudio <no-reply@ebookstudio.local>"

# ---------- OpenAI ----------
OPENAI_API_KEY=
# Model names are configuration, not code. Benchmark cost/quality before fixing defaults.
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_QUALITY_MODEL=gpt-5
OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst
# Product credits per saved image (server-enforced; not provider currency pricing).
IMAGE_GENERATION_CREDITS=20
# Only sent to reasoning models (gpt-5*, o*). Empty = model default.
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT_MS=120000
# Set to 1 to use a deterministic fake AI (tests / no API key)
AI_MOCK=0

# ---------- Object storage ----------
# Leave S3_ENDPOINT empty to store files on the local filesystem (backend/storage).
# For production use AWS S3, Cloudflare R2 or another S3-compatible service.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=ebook-studio
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false

# ---------- Frontend ----------
# Where the Next.js server proxies /api/* to.
BACKEND_INTERNAL_URL=http://localhost:4000
