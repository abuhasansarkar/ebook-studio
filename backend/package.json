{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/server.ts",
    "dev:worker": "tsx watch --env-file=../.env src/worker.ts",
    "build": "prisma generate && tsup",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "generation:audit": "tsx --env-file=../.env scripts/audit-generation.ts",
    "email:status": "tsx --env-file=../.env scripts/email-status.ts",
    "email:check": "tsx --env-file=../.env scripts/check-smtp.ts",
    "fonts:fetch": "node scripts/fetch-fonts.mjs",
    "fonts:verify": "node scripts/fetch-fonts.mjs --verify"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/archiver": "6.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.10",
    "eslint": "9.39.5",
    "globals": "16.4.0",
    "pino-pretty": "^13.2.0",
    "prisma": "7.10.1",
    "supertest": "^7.3.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "@ebook/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "archiver": "7.0.1",
    "better-auth": "^1.7.26",
    "bullmq": "^6.7.8",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "marked": "^18.2.1",
    "nodemailer": "^10.6.0",
    "openai": "^7.60.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.4.299",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "puppeteer": "^25.18.1",
    "sharp": "^0.35.5",
    "stripe": "^23.2.0",
    "zod": "^4.6.7"
  }
}
