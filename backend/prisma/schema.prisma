generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  // Partial indexes express "at most one active job per book" in the schema,
  // so migrate diff agrees with the hand-written migration.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Better Auth tables
// ---------------------------------------------------------------------------
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  /// Set when the person deleted their account. The row is kept, anonymised,
  /// so the credit ledger and payment history stay intact.
  deletedAt     DateTime?
  sessions      Session[]
  accounts      Account[]
  qualityReports QualityReport[]

  projects      Project[]
  books         Book[]
  wallet        CreditWallet?
  transactions  CreditTransaction[]
  jobs          GenerationJob[]
  exports       Export[]
  operations    Operation[]
  assets        Asset[]
  sources       ResearchSource[]
  subscriptions Subscription[]
  payments      Payment[]
  entitlements  Entitlement[]

  // S13 operations
  adminRoles      AdminRole[]
  auditEntries    AdminAuditEntry[]
  supportRequests SupportRequest[]

  // S14 distribution
  packages          DistributionPackage[]
  publishingStatus  PublishingStatus[]
  // S15 marketing
  marketingDrafts   MarketingDraft[]
  marketingGraphics MarketingGraphic[]
  marketingSamples  MarketingSample[]
  // S14 listing copy
  listings          Listing[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Domain
// ---------------------------------------------------------------------------
model Project {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  books       Book[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?
  deletedAt   DateTime?

  @@index([userId])
  @@index([userId, deletedAt, createdAt, id], map: "projects_owner_created_idx")
  @@map("projects")
}

model Book {
  id                String                @id @default(cuid())
  userId            String
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId         String?
  project           Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title             String
  subtitle          String                @default("")
  language          String                @default("en")
  bookType          String                @default("guide")
  /// draft | outline_ready | generating | written | failed
  status            String                @default("draft")
  brief             BookBrief?
  outlines          Outline[]
  chapters          Chapter[]
  coloringPlan      ColoringPlan?
  coloringPages     ColoringPage[]
  jobs              GenerationJob[]
  exports           Export[]
  assetReferences   AssetReference[]
  coverDesigns      CoverDesign[]
  designs           BookDesign[]
  contexts          BookContext[]
  qualityReports    QualityReport[]
  sources           ResearchSource[]
  sourceLinks       ChapterSourceLink[]
  // S14 distribution
  packages          DistributionPackage[]
  publishingStatus  PublishingStatus[]
  // S15 marketing
  marketingDrafts   MarketingDraft[]
  marketingGraphics MarketingGraphic[]
  marketingSamples  MarketingSample[]
  // S14 listing copy
  listings          Listing[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  archivedAt        DateTime?
  deletedAt         DateTime?

  @@index([userId, deletedAt, updatedAt])
  @@index([userId, deletedAt, archivedAt, createdAt, id], map: "books_owner_archive_created_idx")
  @@map("books")
}

model BookBrief {
  id        String   @id @default(cuid())
  bookId    String   @unique
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  /// Full validated BookBrief (see @ebook/shared bookBriefSchema)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("book_briefs")
}

model Outline {
  id         String    @id @default(cuid())
  bookId     String
  book       Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  version    Int
  /// { title, subtitle, chapters: [{ title, goal, keyPoints, targetWords }] }
  data       Json
  approvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([bookId, version])
  @@map("outlines")
}

model Chapter {
  id          String              @id @default(cuid())
  bookId      String
  book        Book                @relation(fields: [bookId], references: [id], onDelete: Cascade)
  position    Int
  title       String
  goal        String              @default("")
  keyPoints   Json                @default("[]")
  targetWords Int                 @default(1500)
  /// pending | generating | done | failed
  status      String              @default("pending")
  /// TipTap/ProseMirror JSON document
  contentJson Json?
  /// Rolling summary used as context for later chapters
  summary     String?
  sourceLinks ChapterSourceLink[]
  generationSections GenerationSection[]
  wordCount   Int                 @default(0)
  /// Optimistic concurrency control
  version     Int                 @default(0)
  error       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  revisions   DocumentVersion[]

  @@unique([bookId, position])
  @@map("chapters")
}

/// Immutable chapter snapshots captured before an editor save or restore.
model DocumentVersion {
  id          String   @id @default(cuid())
  chapterId   String
  chapter     Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  version     Int
  title       String
  contentJson Json?
  wordCount   Int
  savedAt     DateTime
  createdAt   DateTime @default(now())

  @@unique([chapterId, version])
  @@map("document_versions")
}

model GenerationSection {
  id           String        @id @default(cuid())
  jobId        String
  job          GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  chapterId    String
  chapter      Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  position     Int
  /// section | summary | committed
  kind         String
  text         String
  inputTokens  Int           @default(0)
  outputTokens Int           @default(0)
  model        String
  createdAt    DateTime      @default(now())

  @@unique([jobId, chapterId, kind, position])
  @@index([chapterId])
  @@map("generation_sections")
}

model GenerationJob {
  id              String              @id @default(cuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId          String
  book            Book                @relation(fields: [bookId], references: [id], onDelete: Cascade)
  /// outline | chapters | image | quality
  type            String
  /// queued | running | completed | failed | cancelled
  status          String              @default("queued")
  progress        Int                 @default(0)
  total           Int                 @default(0)
  inputSnapshot   Json?
  leaseToken      String?
  leaseExpiresAt  DateTime?
  sections        GenerationSection[]
  assetId         String?
  asset           Asset?              @relation(fields: [assetId], references: [id], onDelete: Restrict)
  qualityReport   QualityReport?
  cancelRequested Boolean             @default(false)
  creditsReserved Int                 @default(0)
  creditsCharged  Int                 @default(0)
  inputTokens     Int                 @default(0)
  outputTokens    Int                 @default(0)
  model           String?
  error           String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([bookId, createdAt])
  @@index([userId])
  // Covers status-only lookups too (leading column), and the lease sweeps.
  @@index([status, leaseExpiresAt])
  @@index([assetId])
  // At most one book-wide job (outline, chapters, image, quality) may be active
  // per book. assertIdle enforces this under the book lock; the index makes it
  // a database invariant. Per-page job kinds are deliberately not covered.
  @@unique([bookId], map: "generation_jobs_one_active_per_book_key", where: raw("(status = ANY (ARRAY['queued'::text, 'running'::text])) AND (type = ANY (ARRAY['outline'::text, 'chapters'::text, 'image'::text, 'quality'::text]))"))
  @@map("generation_jobs")
}

model CreditWallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Spendable balance (excludes reserved)
  balance   Int      @default(0)
  reserved  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("credit_wallets")
}

/// Immutable ledger. Never update or delete rows.
model CreditTransaction {
  id             String   @id @default(cuid())
  userId         String
  // Restrict: the ledger outlives the account. Account deletion anonymises the
  // user row instead of deleting it (services/account/accountDeletionService.ts).
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// grant | reserve | charge | release | refund
  type           String
  amount         Int
  balanceAfter   Int
  reference      String?
  description    String?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@map("credit_transactions")
}

/// A credit reservation that has not been settled yet.
///
/// Every reservation is tracked here so one whose process crashed between
/// reserve and settle can be found and released by the sweeper. `kind` is
/// `job` for reservations owned by a background job (recovered by the job
/// runtime, never swept) and `sync` for a request that reserves and settles
/// inline.
model CreditReservation {
  id        String    @id @default(cuid())
  userId    String
  reference String    @unique
  amount    Int
  /// sync | job
  kind      String    @default("sync")
  settledAt DateTime?
  createdAt DateTime  @default(now())

  @@index([kind, settledAt, createdAt])
  @@index([userId])
  @@map("credit_reservations")
}

// ---------------------------------------------------------------------------
// S12 paid plans, subscriptions, payments and entitlements
// ---------------------------------------------------------------------------

/// A plan in the catalog. The price is in the currency's minor unit.
model Plan {
  id              String         @id
  name            String
  description     String         @default("")
  /// Price in the currency's minor unit: 1200 is USD 12.00.
  priceMinor      Int
  currency        String         @default("USD")
  /// Credits granted when the plan is bought.
  credits         Int            @default(0)
  /// The capabilities this plan carries.
  entitlements    Json           @default("{}")
  /// Only an active plan can be bought.
  active          Boolean        @default(true)
  /// Whether the plan renews at the end of its period.
  recurring       Boolean        @default(false)
  /// The provider's identifier for this plan, when it has one.
  providerPriceId String?
  subscriptions   Subscription[]
  payments        Payment[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("plans")
}

/// A subscription to a plan. Only a verified provider event creates or changes one.
model Subscription {
  id                     String    @id @default(cuid())
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId                 String
  plan                   Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  provider               String    @default("local")
  /// The provider's identifier for this subscription.
  providerSubscriptionId String    @unique
  /// active | trialing | past_due | canceled | incomplete | incomplete_expired
  status                 String
  /// When the current period ends.
  currentPeriodEnd       DateTime?
  /// When the author cancelled. A cancelled subscription runs to the end of its period.
  canceledAt             DateTime?
  /// The provider event this state came from, so an older event cannot overwrite it.
  lastEventAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([userId, status])
  @@index([planId])
  @@map("subscriptions")
}

/// A payment. Credits are granted only from a verified payment.succeeded event.
model Payment {
  id                        String    @id @default(cuid())
  userId                    String
  // Restrict: payment history outlives the account (see CreditTransaction).
  user                      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  planId                    String?
  plan                      Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  provider                  String    @default("local")
  /// The provider's identifier for this payment.
  providerPaymentId         String    @unique
  /// The provider's identifier for the checkout that created this payment.
  providerCheckoutId        String    @unique
  /// The provider's identifier for the customer who is paying.
  providerCustomerReference String    @default("")
  /// Amount in the currency's minor unit.
  amountMinor               Int
  currency                  String    @default("USD")
  /// pending | succeeded | failed | refunded | partially_refunded
  status                    String    @default("pending")
  /// The credits this payment granted.
  credits                   Int       @default(0)
  description               String    @default("")
  /// The provider event that settled this payment.
  settledEventAt            DateTime?
  /// The provider event that refunded it.
  refundedEventAt           DateTime?
  /// The credits this payment took back, when it was refunded.
  refundedCredits           Int       @default(0)
  /// The cumulative amount refunded, in the currency's minor unit.
  refundedAmountMinor       Int       @default(0)
  /// Credits a refund was owed but could not take because they were spent.
  refundShortfallCredits    Int       @default(0)
  /// The provider subscription this payment paid for, when it was an invoice.
  providerSubscriptionId    String?
  /// The provider invoice this payment settled, when it was an invoice.
  providerInvoiceId         String?   @unique
  /// open | won | lost, when the payment was disputed.
  disputeStatus             String?
  /// Credits taken back by an open or lost dispute.
  disputedCredits           Int       @default(0)
  disputedEventAt           DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status])
  @@index([planId])
  @@index([providerCustomerReference])
  @@index([providerSubscriptionId])
  @@map("payments")
}

/// The webhook inbox. Every received event is recorded before it is applied.
model PaymentEvent {
  id              String    @id @default(cuid())
  provider        String    @default("local")
  /// The provider's identifier for this event. A repeat delivery is a no-op.
  providerEventId String    @unique
  type            String
  /// The provider's timestamp, used to reject an event that arrives out of order.
  occurredAt      DateTime
  /// The payload as received.
  payload         Json
  /// The signature of the payload, so a stored event can be re-verified.
  signature       String    @default("")
  /// received | processed | ignored | failed
  status          String    @default("received")
  error           String?
  processedAt     DateTime?
  /// How many deliveries have tried to apply this event.
  attempts        Int       @default(1)
  /// When the current attempt claimed the event. A `received` row whose claim
  /// is stale belongs to a crashed attempt and may be re-claimed.
  claimedAt       DateTime  @default(now())
  createdAt       DateTime  @default(now())

  @@index([provider, createdAt])
  @@index([status])
  @@map("payment_events")
}

/// A capability the author holds. Only verified payment state grants one.
model Entitlement {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The entitlement key, one of ENTITLEMENT_KEYS.
  key       String
  /// The value: a number, a boolean or a string.
  value     Json
  /// plan | subscription | payment
  source    String    @default("subscription")
  /// The record that granted it.
  sourceId  String?
  /// When the entitlement stops applying.
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, key])
  @@index([userId])
  @@map("entitlements")
}

model Export {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId         String
  book           Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  /// pdf | epub | docx
  format         String
  /// queued | processing | ready | failed
  status         String    @default("queued")
  storageKey     String?
  fileSize       Int?
  pageCount      Int?
  error          String?
  /// Book design version captured at request time (0 = default design); null for pre-S08 exports
  designVersion  Int?
  /// Immutable design snapshot rendered by the worker; null for pre-S08 exports
  designSnapshot Json?
  /// Post-render findings such as glyphs drawn by non-bundled fonts
  diagnostics    Json?
  /// Immutable export snapshot: options, chapter versions, pinned assets and content hash
  snapshot       Json?
  /// Validation result of the file read back from storage; null until the worker validates it
  validation     Json?
  /// SHA-256 of the stored file, used to detect a replaced or corrupted artifact
  sha256         String?
  /// MIME type of the stored file
  contentType    String?
  /// Worker ownership: the token of the worker rendering the file and when its lease lapses.
  /// A processing export whose lease lapsed was interrupted and is reconciled as failed.
  leaseToken     String?
  leaseExpiresAt DateTime?
  /// Times a worker has claimed this export; a crash-looping render stops after a bounded number.
  attempts       Int       @default(0)
  startedAt      DateTime?
  createdAt      DateTime  @default(now())
  finishedAt     DateTime?

  @@index([bookId, createdAt])
  @@index([userId])
  @@index([status])
  @@map("exports")
}

/// Durable request identity. Submitted work references existing generation/export records.
model Operation {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  idempotencyKey String
  requestHash    String
  kind           String
  bookId         String?
  resourceId     String?
  /// submitting | submitted | failed | needs_review
  state          String   @default("submitting")
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@map("operations")
}

/// Durable dispatch retries; processors must still guard domain-side effects.
model QueueDispatch {
  id            String    @id @default(cuid())
  namespace     String
  queue         String
  jobId         String
  fingerprint   String
  payload       Json
  dispatchedAt  DateTime?
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@unique([namespace, queue, jobId])
  @@index([namespace, dispatchedAt, nextAttemptAt])
  @@map("queue_dispatches")
}

/// Short-lived encrypted OTP delivery; never exposes recipient or code in logs/API.
model EmailDelivery {
  id             String    @id @default(cuid())
  verificationId String    @unique
  runtimeId      String
  type           String
  payload        String?
  status         String    @default("queued")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  expiresAt      DateTime
  leaseToken     String?
  leaseExpiresAt DateTime?
  failureCode    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([runtimeId, status, nextAttemptAt])
  @@index([expiresAt])
  @@map("email_deliveries")
}

/// Only sanitized raster bytes become ready. Originals are never persisted.
model Asset {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  storageKey String           @unique
  status     String           @default("processing")
  mediaType  String           @default("image/webp")
  sha256     String
  width      Int
  height     Int
  bytes      Int
  alt        String           @default("")
  caption    String           @default("")
  provenance String           @default("user_upload")
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  references AssetReference[]
  imageJobs  GenerationJob[]
  coloringPages ColoringPage[]

  @@index([userId, status, id])
  @@map("assets")
}

/// Conservative lifetime pin: keeps chapter history and copied manuscripts readable.
model AssetReference {
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@id([assetId, bookId])
  @@index([bookId])
  @@map("asset_references")
}

model CoverDesign {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  version   Int
  data      Json
  createdAt DateTime @default(now())

  @@unique([bookId, version])
  @@map("cover_designs")
}

/// Immutable interior design versions. Template application and restore create new versions.
model BookDesign {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  version   Int
  data      Json
  /// save | template | restore
  action    String
  /// e.g. template id/version or restored version
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@unique([bookId, version])
  @@map("book_designs")
}

/// Versioned voice and terminology used by quality checks and AI review.
model BookContext {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  version   Int
  data      Json
  createdAt DateTime @default(now())

  @@unique([bookId, version])
  @@map("book_contexts")
}

/// A quality report over an exact input fingerprint. Analysis never edits the manuscript.
model QualityReport {
  id           String           @id @default(cuid())
  bookId       String
  book         Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// rules | ai
  kind         String
  /// queued | running | completed | failed | cancelled (AI reports follow their job)
  status       String
  rulesVersion Int
  fingerprint  String
  /// Chapter ids/versions, design/context versions and other inputs the report was computed from
  inputs       Json
  /// Counts by severity/category, coverage (checks run and not run), discarded AI references
  summary      Json?
  jobId        String?          @unique
  job          GenerationJob?   @relation(fields: [jobId], references: [id], onDelete: Restrict)
  findings     QualityFinding[]
  createdAt    DateTime         @default(now())
  completedAt  DateTime?

  @@index([bookId, createdAt])
  @@index([userId])
  @@map("quality_reports")
}

model QualityFinding {
  id               String        @id @default(cuid())
  reportId         String
  report           QualityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  /// Stable identity across reports (rule + chapter + quote) for carrying review decisions forward
  key              String
  ruleId           String
  category         String
  severity         String
  /// rule | heuristic | ai
  method           String
  chapterId        String?
  anchor           Json?
  message          String
  evidence         String        @default("")
  suggestion       Json?
  needsHumanReview Boolean       @default(false)
  /// open | resolved | dismissed
  status           String        @default("open")
  reviewNote       String        @default("")
  reviewedById     String?
  reviewedByName   String?
  reviewedAt       DateTime?
  createdAt        DateTime      @default(now())

  @@index([reportId])
  @@index([key])
  @@map("quality_findings")
}

// ---------------------------------------------------------------------------
// S11 sources and imports
// ---------------------------------------------------------------------------

/// A private document the author imported. The original file stays private.
model ResearchSource {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId     String
  book       Book                @relation(fields: [bookId], references: [id], onDelete: Cascade)
  title      String
  /// notes | docx | pdf
  format     String
  /// Where the document came from, in the author's own words.
  provenance String              @default("")
  /// Permission or licensing note, in the author's own words.
  license    String              @default("")
  /// Current extracted version; 0 until a file has been extracted.
  version    Int                 @default(0)
  /// pending | ready | empty | scanned | failed
  status     String              @default("pending")
  /// Storage key of the original uploaded file; null once it has been removed.
  storageKey String?
  /// SHA-256 of the original uploaded bytes.
  sha256     String?
  bytes      Int                 @default(0)
  error      String?
  /// Set when the author deleted the source. The row is kept so a chapter that
  /// cited it can report that the text it rested on is gone.
  deletedAt  DateTime?
  versions   SourceVersion[]
  links      ChapterSourceLink[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([bookId, createdAt])
  @@index([userId, createdAt])
  @@index([bookId, deletedAt])
  @@map("research_sources")
}

/// An immutable extraction of one uploaded file. Citations point at a version.
model SourceVersion {
  id             String         @id @default(cuid())
  sourceId       String
  source         ResearchSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  version        Int
  /// notes | docx | pdf
  format         String
  /// SHA-256 of the original uploaded bytes.
  sha256         String
  bytes          Int
  /// ready | empty | scanned | failed
  status         String
  passageCount   Int            @default(0)
  characterCount Int            @default(0)
  /// Extraction warnings: truncated passages, unsupported elements, missing text layer.
  warnings       Json           @default("[]")
  /// Extracted passages with their stable locators.
  passages       Json           @default("[]")
  /// Set when this version was applied to the manuscript.
  appliedAt      DateTime?
  createdAt      DateTime       @default(now())

  @@unique([sourceId, version])
  @@map("source_versions")
}

/// A chapter and the source passages the author linked to it.
model ChapterSourceLink {
  id            String         @id @default(cuid())
  sourceId      String
  source        ResearchSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  bookId        String
  book          Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapterId     String
  chapter       Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  /// Locators of the passages that support this chapter.
  locators      Json           @default("[]")
  note          String         @default("")
  /// The source version that was current when the link was made.
  sourceVersion Int            @default(0)
  /// Digest of the cited passages, so a changed text can be detected.
  passageDigest String         @default("")
  createdAt     DateTime       @default(now())

  @@unique([sourceId, chapterId])
  @@index([chapterId])
  @@index([bookId])
  @@map("chapter_source_links")
}

/// S13 — the role an account holds.
///
/// A role is the *only* thing that grants an operator a capability. The
/// backend checks it on every privileged route; the admin navigation in the
/// browser is a convenience, never the control.
model AdminRole {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// support | finance | administrator
  role         String
  /// Why this role was granted, and who granted it.
  reason       String    @default("")
  grantedBy    String?
  grantedAt    DateTime  @default(now())
  revokedAt    DateTime?
  revokedBy    String?
  revokeReason String?

  @@unique([userId, role])
  @@index([role])
  @@map("admin_roles")
}

/// S13 — an immutable record of a privileged action.
///
/// Audit entries are written, never edited or deleted. The row records who
/// acted, what they acted on, why, and what happened, so a credit adjustment
/// or a job intervention can be explained afterwards.
model AdminAuditEntry {
  id         String   @id @default(cuid())
  /// The operator's user id. Null for a system action.
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// The role the actor held at the time.
  actorRole  String?
  /// The action, for example `credits.adjust` or `job.cancel`.
  action     String
  /// The kind of thing acted on, for example `user` or `generation_job`.
  targetType String
  targetId   String
  /// Why the operator did it. Required for anything that changes value.
  reason     String   @default("")
  /// What the action changed, in a safe summary form.
  outcome    String   @default("ok")
  /// The before and after state, without secrets or personal content.
  details    Json     @default("{}")
  /// The request id that produced the action, so it can be correlated.
  requestId  String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("admin_audit_entries")
}

/// S13 — an operational incident worth an operator's attention.
///
/// An incident records a failure that the product noticed: a queue that grew
/// old, a delivery that failed permanently, a payment that failed, a
/// reconciliation gap. It is a record, not a repair: nothing here changes
/// product state on its own.
model OperationalIncident {
  id          String    @id @default(cuid())
  /// The kind of incident, for example `queue_backlog` or `payment_failed`.
  kind        String
  severity    String    @default("warning")
  /// A short, safe summary. Never contains credentials or message content.
  summary     String
  /// The thing the incident is about.
  subjectType String?
  subjectId   String?
  /// Whether an operator has looked at it.
  resolvedAt  DateTime?
  resolvedBy  String?
  resolution  String?
  createdAt   DateTime  @default(now())

  @@index([kind])
  @@index([resolvedAt])
  @@index([createdAt])
  @@map("operational_incidents")
}

/// S13 — a backup manifest and the evidence that it can be restored.
///
/// The manifest records what was captured and its checksums. The restore
/// evidence records a rehearsal: what was restored, into where, and whether
/// the recovered data was intact.
model BackupManifest {
  id              String    @id @default(cuid())
  /// A stable identifier for this backup.
  name            String    @unique
  /// The database dump and the asset archive.
  databaseFile    String
  assetsFile      String?
  bytes           Int       @default(0)
  /// SHA-256 of each artefact.
  databaseSha256  String
  assetsSha256    String?
  /// Whether the backup was encrypted, and with which key identifier.
  encrypted       Boolean   @default(false)
  keyId           String?
  /// The counts that prove the backup holds something.
  counts          Json      @default("{}")
  /// A rehearsal of the restore, when one has been done.
  restoredAt      DateTime?
  restoredInto    String?
  restoreVerified Boolean   @default(false)
  restoreNotes    String?
  createdAt       DateTime  @default(now())

  @@map("backup_manifests")
}

/// S13 — a support request from a customer.
///
/// The submission is stored with a correlation id so a support agent can find
/// the workflow the customer was in. No message is sent anywhere without a
/// separately configured authorization.
model SupportRequest {
  id            String    @id @default(cuid())
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// The correlation id shared with the client's logs.
  correlationId String
  category      String    @default("question")
  subject       String
  message       String
  /// The route or feature the customer was on.
  context       String?
  email         String?
  status        String    @default("open")
  /// The operator's reply.
  response      String?
  respondedBy   String?
  respondedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("support_requests")
}

/// S13 — a record of an alert being delivered.
///
/// An alert that was never delivered is a failed alert, and this is where
/// that is recorded rather than assumed.
model AlertDelivery {
  id          String   @id @default(cuid())
  /// The alert that was raised.
  kind        String
  severity    String   @default("warning")
  summary     String
  /// Where it was sent.
  destination String
  /// delivered | failed
  status      String
  /// The failure reason, when it failed.
  error       String?
  /// The incident the alert was raised for.
  incidentId  String?
  createdAt   DateTime @default(now())

  @@index([kind])
  @@index([status])
  @@map("alert_deliveries")
}

/// S14 — a distribution package prepared for one destination.
///
/// The package records what it holds and which rules version it was checked
/// against, so a download can be traced back to the manuscript it came from.
/// It is a file the author uploads to a store themselves: the product never
/// publishes on the author's behalf.
model DistributionPackage {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId          String
  book            Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  /// The destination this package was prepared for.
  destination     String
  /// assembling | ready | blocked | failed
  status          String   @default("assembling")
  /// The destination rules the package was checked against.
  rulesVersion    String   @default("")
  /// The files the package holds.
  files           Json
  /// The total size in bytes.
  bytes           Int      @default(0)
  /// The checks that were run against the package.
  checks          Json
  /// The metadata the author supplied.
  metadata        Json
  /// The chapter versions captured when the package was made.
  chapterVersions Json
  /// The storage key of the assembled ZIP.
  storageKey      String?
  /// The reason the package failed or was blocked.
  error           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, bookId, createdAt])
  @@index([status])
  @@map("distribution_packages")
}

/// S14 — the author's own publishing status for a destination.
///
/// The author sets this. The product records it and never changes it, because
/// only the author knows whether a store accepted the book.
model PublishingStatus {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId            String
  book              Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  destination       String
  /// not_prepared | in_progress | submitted | published
  state             String   @default("not_prepared")
  /// The store's own reference for the listing.
  externalReference String?
  note              String?
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  @@unique([userId, bookId, destination])
  @@index([bookId])
  @@map("publishing_statuses")
}

/// S15 — a marketing draft.
///
/// The draft stays editable and is never published by the product. The
/// chapter versions it was written from are kept, so a draft that no longer
/// matches the manuscript is visible as stale.
model MarketingDraft {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId          String
  book            Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  /// The kind of material this is.
  outputType      String
  /// draft | edited | approved
  status          String   @default("draft")
  /// The text, which the author may edit.
  content         String   @default("")
  tone            String   @default("clear")
  audience        String?
  instruction     String?
  /// The chapter versions the draft was written from.
  chapterVersions Json
  /// The rules version the draft was produced under.
  rulesVersion    String   @default("")
  /// The claims the author should look at.
  flags           Json
  /// The credits the draft cost.
  creditsCharged  Int      @default(0)
  /// The version, used to refuse a lost edit.
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, bookId, createdAt])
  @@index([bookId, outputType])
  @@map("marketing_drafts")
}

/// S15 — a composed promotional graphic.
model MarketingGraphic {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId          String
  book            Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  template        String
  width           Int
  height          Int
  headline        String
  subhead         String?
  callToAction    String?
  textColor       String   @default("#1b1b1f")
  backgroundColor String   @default("#f5f1e8")
  usedCover       Boolean  @default(false)
  /// The storage key of the rendered image.
  storageKey      String?
  /// Whether the image was rendered and verified.
  ready           Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, bookId, createdAt])
  @@map("marketing_graphics")
}

/// S15 — the sample chapters an author chose to hand out.
model MarketingSample {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId          String
  book            Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  /// The chapters included, in order.
  chapterIds      Json
  /// The format the sample was produced in.
  format          String   @default("pdf")
  /// The manuscript versions the sample was taken from.
  chapterVersions Json
  /// The storage key of the assembled sample.
  storageKey      String?
  ready           Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, bookId, createdAt])
  @@map("marketing_samples")
}

/// S14 — the listing copy an author submits to a store themselves.
///
/// A listing holds the fields the store's own form asks for, the price the
/// author chose, and the chapter versions the drafts were written from. The
/// product never submits a listing to a store; it prepares the text and
/// calculates what the author would keep.
model Listing {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId          String
  book            Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  /// The destination this listing is prepared for.
  destination     String
  /// The price the author chose, in the smallest currency unit.
  priceInMinorUnits Int    @default(0)
  /// The listing fields, keyed by the destination's field key.
  fields          Json     @default("{}")
  /// The fields the author has confirmed.
  confirmed       Json     @default("{}")
  /// The chapter versions the drafts were written from.
  chapterVersions Json
  /// The rules version the listing was produced under.
  rulesVersion    String   @default("")
  /// The version, used to refuse a lost edit.
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, bookId, destination])
  @@index([bookId, createdAt])
  @@map("listings")
}

// ---------------------------------------------------------------------------
// AI Coloring Book Studio
// ---------------------------------------------------------------------------

model ColoringPlan {
  id              String    @id @default(cuid())
  bookId          String    @unique
  book            Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  topic           String
  artStyle        String
  targetAudience  String
  difficulty      String
  lineThickness   String
  trimSize        String
  bleed           Boolean   @default(false)
  singleSided     Boolean   @default(true)
  pageCount       Int       @default(24)
  density         String    @default("balanced")
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("coloring_plans")
}

model ColoringPage {
  id              String    @id @default(cuid())
  bookId          String
  book            Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  pageNumber      Int
  title           String
  description     String    @default("")
  prompt          String
  negativePrompt  String?
  caption         String?
  status          String    @default("pending")
  assetId         String?
  asset           Asset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)
  qualityChecks   Json?
  error           String?
  /// The background generation job (type `coloring_page`) currently producing this
  /// page's illustration. Set while status is `generating`; a job only writes to
  /// the page while it is still the page's current job.
  generationJobId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([bookId, pageNumber])
  @@index([bookId, status])
  @@index([assetId])
  @@index([status, updatedAt])
  @@index([generationJobId])
  @@map("coloring_pages")
}
